  title = {Two-Dimensional Electronic Spectroscopy of Molecular Aggregates},
  author = {Ginsberg, Naomi S. and Cheng, Yuan-Chung and Fleming, Graham R.},
  date = {2009-09-15},
  journaltitle = {Acc. Chem. Res.},
  volume = {42},
