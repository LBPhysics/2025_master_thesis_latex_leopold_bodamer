@article{nothlingetal2025accuracyapproximatemethods,
  title = {Accuracy of Approximate Methods for the Calculation of Fluorescence-Type Linear Spectra with a Complex System--Bath Coupling},
  author = {N\"othling, J. A. and Man\v cal, Tom\'a\v s and Kr\"uger, T. P. J.},
