  file = {C\:\\Users\\leopo\\Zotero\\storage\\PXRDIWIH\\Lambrev et al. - 2020 - Insights into the mechanisms and dynamics of energy transfer in plant light-harvesting complexes fro.pdf;C\:\\Users\\leopo\\Zotero\\storage\\EKVWL4LM\\S0005272819300817.html}
