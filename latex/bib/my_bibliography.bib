@article{palmnalbach2019dephasingrelaxationalpolarized,
  title = {Dephasing and Relaxational Polarized Sub-Ohmic Baths Acting on a Two-Level System},
  author = {Palm, T. and Nalbach, P.},
  date = {2019-06-18},
  journaltitle = {J. Chem. Phys.},
  volume = {150},
