  author = {Cao, Jianshu and Cogdell, Richard J. and Coker, David F. and Duan, Hong-Guang and Hauer, J\"urgen and Kleinekath\"ofer, Ulrich and Jansen, Thomas L. C. and Man\v cal, Tom\'a\v s and Miller, R. J. Dwayne and Ogilvie, Jennifer P. and Prokhorenko, Valentyn I. and Renger, Thomas and Tan, Howe-Siang and Tempelaar, Roel and Thorwart, Michael and Thyrhaug, Erling and Westenhoff, Sebastian and Zigmantas, Donatas},
